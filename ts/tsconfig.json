{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "../dist",
    "tsBuildInfoFile": "../dist/compile.tsbuildInfo",
    "strict": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
