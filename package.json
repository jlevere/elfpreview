{
  "name": "elfpreview",
  "displayName": "elfPreview",
  "description": "Preview ELF binary files in VS Code",
  "publisher": "jlevere",
  "author": "https://github.com/jlevere",
  "version": "0.1.3",
  "keywords": [
    "VSCode",
    "Elf",
    "Editor",
    "Preview",
    "Binary"
  ],
  "categories": [
    "Other"
  ],
  "icon": "docs/elfpreview.png",
  "galleryBanner": {
    "color": "#777777",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlevere/elfpreview.git"
  },
  "bugs": {
    "url": "https://github.com/jlevere/elfpreview/issues"
  },
  "homepage": "https://github.com/jlevere/elfpreview#readme",
  "engines": {
    "vscode": "^1.98.0",
    "node": "^v22.13.1"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "elfpreview.showPreview",
        "title": "ELF: Show Preview"
      }
    ],
    "customEditors": [
      {
        "viewType": "elfpreview.elfViewer",
        "displayName": "ELF Preview",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "elfpreview.showPreview",
          "when": "resourceScheme == 'file'"
        }
      ],
      "explorer/context": [
        {
          "command": "elfpreview.showPreview",
          "when": "resourceScheme == 'file'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm check && pnpm esbuild && pnpm compile:rust",
    "package": "pnpm check && pnpm esbuild:prod && pnpm compile:rust && pnpm vsce:package",
    "publish": "pnpm package && pnpm vsce:publish",
    "prepare-dist": "pnpm exec mkdirp dist",
    "clean": "pnpm exec rimraf dist",
    "esbuild": "node esbuild.js",
    "esbuild:prod": "node esbuild.js --production",
    "watch:esbuild": "pnpm esbuild --watch",
    "compile:rust": "cargo build --locked --release --target wasm32-unknown-unknown && node scripts/copy-wasm.mjs",
    "lint": "pnpm exec eslint ./ts/src ./webview/src",
    "test": "pnpm test:rust && pnpm test:wasm",
    "generate:wit": "node scripts/generate-wit.mjs",
    "vsce:package": "pnpm exec vsce package",
    "vsce:publish": "pnpm exec vsce publish",
    "check": "pnpm check:generated && pnpm lint && pnpm check:types",
    "check:types": "tsc --noEmit -p ts/tsconfig.json && svelte-check --tsconfig webview/tsconfig.json",
    "test:rust": "cargo test --locked",
    "test:extension": "node scripts/test-extension.mjs",
    "watch:tsc": "tsc --noEmit --watch -p ts/tsconfig.json",
    "check:generated": "node scripts/generate-wit.mjs --check",
    "test:wasm": "node scripts/test-node.mjs ts/test/wasm.test.ts ts/test/protocol.test.ts ts/test/worker.test.ts",
    "test:ui": "node scripts/test-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@sveltejs/eslint-config": "^8.2.0",
    "@tsconfig/svelte": "5",
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.0.14",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/vsce": "^3.3.1",
    "@vscode/wasm-component-model": "1.0.2",
    "esbuild": "^0.25.1",
    "esbuild-svelte": "^0.9.2",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-svelte": "^3.3.3",
    "globals": "^16.0.0",
    "mkdirp": "^3.0.1",
    "playwright": "1.65.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "rimraf": "^6.0.1",
    "svelte": "^5.36.1",
    "svelte-check": "^4.1.5",
    "svelte-preprocess": "^6.0.3",
    "svelte-virtuallists": "^1.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.37.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "keytar",
      "esbuild",
      "svelte-preprocess"
    ]
  },
  "packageManager": "pnpm@10.12.4"
}
