{
  "name": "elfpreview",
  "displayName": "elfPreview",
  "description": "Preview ELF binary files in VS Code",
  "publisher": "jlevere",
  "author": "https://github.com/jlevere",
  "version": "0.1.3",
  "keywords": [
    "VSCode",
    "Elf",
    "Editor",
    "Preview",
    "Binary"
  ],
  "categories": [
    "Other"
  ],
  "icon": "docs/elfpreview.png",
  "galleryBanner": {
    "color": "#777777",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlevere/elfpreview.git"
  },
  "bugs": {
    "url": "https://github.com/jlevere/elfpreview/issues"
  },
  "homepage": "https://github.com/jlevere/elfpreview#readme",
  "engines": {
    "vscode": "^1.98.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "elfpreview.showPreview",
        "title": "ELF: Show Preview"
      }
    ],
    "customEditors": [
      {
        "viewType": "elfpreview.elfViewer",
        "displayName": "ELF Preview",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "elfpreview.showPreview",
          "when": "resourceScheme != 'untitled'"
        }
      ],
      "explorer/context": [
        {
          "command": "elfpreview.showPreview",
          "when": "resourceScheme != 'untitled'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm check && pnpm esbuild && pnpm compile:rust",
    "package": "pnpm exec vsce package --no-dependencies",
    "publish": "pnpm exec vsce publish --no-dependencies",
    "clean": "node scripts/clean.mts",
    "esbuild": "node esbuild.mts",
    "esbuild:prod": "node esbuild.mts --production",
    "watch:esbuild": "pnpm esbuild --watch",
    "compile:rust": "cargo build --locked --release --target wasm32-unknown-unknown && node scripts/copy-wasm.mts",
    "lint": "pnpm exec eslint ./ts/src ./webview/src ./scripts esbuild.mts eslint.config.mts",
    "test": "pnpm test:rust && pnpm test:wasm",
    "generate:wit": "node scripts/generate-wit.mts",
    "check": "pnpm check:generated && pnpm lint && pnpm check:types",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ts/tsconfig.json && svelte-check --tsconfig webview/tsconfig.json --fail-on-warnings",
    "test:rust": "cargo test --locked",
    "test:extension": "node scripts/test-extension.mts",
    "watch:tsc": "tsc --noEmit --watch -p ts/tsconfig.json",
    "check:generated": "node scripts/generate-wit.mts --check",
    "test:wasm": "pnpm esbuild && pnpm compile:rust && node scripts/test-node.mts ts/test/wasm.test.ts ts/test/protocol.test.ts ts/test/worker.test.ts scripts/ui.test.mts",
    "test:ui": "node scripts/test-ui.mts",
    "check:rust": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "vscode:prepublish": "pnpm check && pnpm esbuild:prod && pnpm compile:rust"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.98.0",
    "@vscode/vsce": "^4.1.1",
    "@vscode/wasm-component-model": "1.0.2",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-virtuallists": "^1.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@10.34.9",
  "extensionKind": [
    "workspace"
  ]
}
